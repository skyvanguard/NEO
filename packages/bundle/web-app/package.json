    "@neo/dsh-client-ui-deliverables": "workspace:^",
    "@neo/dsh-client-ui-directory-picker-browse": "workspace:^",
    "@neo/dsh-client-ui-directory-picker-native": "workspace:^",
    "@neo/dsh-client-ui-message-feedback": "workspace:^",
    "@neo/dsh-client-ui-goal": "workspace:^",
    "@neo/dsh-client-ui-layout": "workspace:^",
