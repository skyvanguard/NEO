{
  "name": "@neo/hooks-claude-code",
  "description": "Bridge plugin: run a Claude Code hooks.json / settings hook config on the DeepSeek Harness interception seams",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/hooks/hooks-claude-code"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@neo/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@neo/agent": "workspace:^",
    "@neo/hook-protocol": "workspace:^",
    "@neo/invariants": "workspace:^",
    "@neo/llm": "workspace:^",
    "@neo/session": "workspace:^",
    "@neo/session-persistence": "workspace:^",
    "@neo/subagent": "workspace:^",
    "@neo/tools": "workspace:^",
    "@neo/cordis": "workspace:^"
  },
  "devDependencies": {
    "@neo/agent": "workspace:^",
    "@neo/agent-loop": "workspace:^",
    "@neo/agent-loop-testkit": "workspace:^",
    "@neo/shell": "workspace:^",
    "@neo/bash-local": "workspace:^",
    "@neo/subprocess-local": "workspace:^",
    "@neo/hook-protocol": "workspace:^",
    "@neo/invariants": "workspace:^",
    "@neo/llm": "workspace:^",
    "@neo/session": "workspace:^",
    "@neo/session-persistence": "workspace:^",
    "@neo/session-persistence-jsonl": "workspace:^",
    "@neo/subagent": "workspace:^",
    "@neo/tools": "workspace:^",
    "@neo/cordis": "workspace:^"
  }
}
