{
  "name": "@neo/tool-fs-search",
  "description": "Model-facing filesystem discovery tools (glob, grep) backed by the packaged ripgrep binary (@vscode/ripgrep)",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/fs/tool-fs-search"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@vscode/ripgrep": "^1.18.0",
    "@neo/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@neo/invariants": "workspace:^",
    "@neo/llm": "workspace:^",
    "@neo/output-retention": "workspace:^",
    "@neo/session": "workspace:^",
    "@neo/spill": "workspace:^",
    "@neo/subprocess": "workspace:^",
    "@neo/system-prompt": "workspace:^",
    "@neo/timeout": "workspace:^",
    "@neo/tools": "workspace:^",
    "@neo/cordis": "workspace:^"
  },
  "devDependencies": {
    "@neo/agent": "workspace:^",
    "@neo/subprocess": "workspace:^",
    "@neo/subprocess-local": "workspace:^",
    "@neo/invariants": "workspace:^",
    "@neo/llm": "workspace:^",
    "@neo/output-retention": "workspace:^",
    "@neo/session": "workspace:^",
    "@neo/spill": "workspace:^",
    "@neo/system-prompt": "workspace:^",
    "@neo/timeout": "workspace:^",
    "@neo/tools": "workspace:^",
    "@neo/cordis": "workspace:^"
  }
}
