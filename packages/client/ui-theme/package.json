{
  "name": "@neo/client-ui-theme",
  "description": "Theme plugin: Host bootstrap for the pre-plugin palette; DOM-free ThemeRuntime for light/dark/system state; --dsw-* token styles and Appearance settings row",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-theme"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./styles/*": "./lib/styles/*",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@neo/client-connection",
        "@neo/client-runtime",
        "@neo/client-locale",
        "@neo/client-ui-settings",
        "@neo/api-remotes"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@neo/cordis": "workspace:^",
    "@neo/api-remotes": "workspace:^",
    "@neo/client-connection": "workspace:^",
    "@neo/client-locale": "workspace:^",
    "@neo/client-runtime": "workspace:^",
    "@neo/client-ui-primitives": "workspace:^",
    "@neo/client-ui-settings": "workspace:^",
    "@neo/client-ui-slots": "workspace:^",
    "@neo/host-webserver": "workspace:^",
    "@neo/invariants": "workspace:^",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@neo/cordis": "workspace:^",
    "@neo/api-remotes": "workspace:^",
    "@neo/client-locale": "workspace:^",
    "@neo/client-runtime": "workspace:^",
    "@neo/client-test-runtime": "workspace:^",
    "@neo/client-ui-primitives": "workspace:^",
    "@neo/client-ui-settings": "workspace:^",
    "@neo/client-ui-slots": "workspace:^",
    "@neo/host-webserver": "workspace:^",
    "@neo/invariants": "workspace:^",
    "@types/react": "~18.3.1",
    "react": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/styles",
    "lib/types/**/*.d.ts"
  ],
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "dependencies": {
    "@neo/settings": "workspace:^",
    "clsx": "^2.0.0",
    "@neo/schemastery": "workspace:^"
  }
}
