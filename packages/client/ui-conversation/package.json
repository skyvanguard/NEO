{
  "name": "@neo/client-ui-conversation",
  "description": "Conversation domain: skeleton, ordered chat flow, composer with the Host-backed busy-Enter preference, and details host",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-conversation"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@neo/client-connection",
        "@neo/client-locale",
        "@neo/client-runtime",
        "@neo/client-ui-settings",
        "@neo/api-remotes",
        "@neo/client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "@neo/settings": "workspace:^",
    "clsx": "^2.0.0",
    "@neo/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@neo/cordis": "workspace:^",
    "@neo/agent": "workspace:^",
    "@neo/api-remotes": "workspace:^",
    "@neo/attachment": "workspace:^",
    "@neo/brand": "workspace:^",
    "@neo/client-connection": "workspace:^",
    "@neo/client-locale": "workspace:^",
    "@neo/client-runtime": "workspace:^",
    "@neo/client-ui-attachment": "workspace:^",
    "@neo/client-ui-primitives": "workspace:^",
    "@neo/client-ui-settings": "workspace:^",
    "@neo/client-ui-input-trigger": "workspace:^",
    "@neo/client-ui-slots": "workspace:^",
    "@neo/commands": "workspace:^",
    "@neo/compaction": "workspace:^",
    "@neo/invariants": "workspace:^",
    "@neo/llm-retry": "workspace:^",
    "@neo/session-stats": "workspace:^",
    "@neo/token-meter": "workspace:^",
    "@neo/tools": "workspace:^",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@neo/cordis": "workspace:^",
    "@neo/agent": "workspace:^",
    "@neo/api-remotes": "workspace:^",
    "@neo/attachment": "workspace:^",
    "@neo/brand": "workspace:^",
    "@neo/client-connection": "workspace:^",
    "@neo/client-locale": "workspace:^",
    "@neo/client-runtime": "workspace:^",
    "@neo/client-test-runtime": "workspace:^",
    "@neo/client-ui-layout": "workspace:^",
    "@neo/client-ui-attachment": "workspace:^",
    "@neo/client-ui-primitives": "workspace:^",
    "@neo/client-ui-settings": "workspace:^",
    "@neo/client-ui-input-trigger": "workspace:^",
    "@neo/client-ui-slots": "workspace:^",
    "@neo/commands": "workspace:^",
    "@neo/compaction": "workspace:^",
    "@neo/goal": "workspace:^",
    "@neo/invariants": "workspace:^",
    "@neo/llm-retry": "workspace:^",
    "@neo/permission-presets": "workspace:^",
    "@neo/plan-mode": "workspace:^",
    "@neo/session-projection": "workspace:^",
    "@neo/session-stats": "workspace:^",
    "@neo/token-meter": "workspace:^",
    "@neo/tool-todo": "workspace:^",
    "@neo/tools": "workspace:^",
    "@types/react": "~18.3.1",
    "react": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
