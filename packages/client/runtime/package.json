{
  "name": "@neo/client-runtime",
  "description": "Client core services: SlotRegistry, SessionRuntime (scope tree + object layer)",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/runtime"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@neo/client-connection",
        "@neo/typert-registry",
        "@neo/api-remotes"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "dependencies": {
    "@neo/agent": "workspace:^",
    "@neo/attachment": "workspace:^",
    "@neo/client-connection": "workspace:^",
    "@neo/commands": "workspace:^",
    "@neo/client-ui-slots": "workspace:^",
    "@neo/host-apiproxy": "workspace:^",
    "@neo/llm": "workspace:^",
    "@neo/llm-retry": "workspace:^",
    "@neo/session": "workspace:^",
    "@neo/session-projection": "workspace:^",
    "@neo/session-title": "workspace:^",
    "@neo/tools": "workspace:^",
    "immer": "^10.1.1",
    "react": "^18.2.0",
    "zustand": "~4.4.7"
  },
  "peerDependencies": {
    "@neo/cordis": "workspace:^",
    "@neo/api-remotes": "workspace:^",
    "@neo/invariants": "workspace:^",
    "@neo/typert-protocol": "workspace:^",
    "@neo/typert-registry": "workspace:^"
  },
  "devDependencies": {
    "@neo/cordis": "workspace:^",
    "@neo/api-remotes": "workspace:^",
    "@neo/invariants": "workspace:^",
    "@neo/timeout": "workspace:^",
    "@neo/typert-protocol": "workspace:^",
    "@neo/typert-registry": "workspace:^",
    "@types/react": "~18.3.1"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
