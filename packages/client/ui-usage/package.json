{
  "name": "@neo/dsh-client-ui-usage",
  "description": "Cumulative cross-session token-usage panel in Web Settings",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@neo/dsh-api-remotes",
        "@neo/dsh-client-runtime",
        "@neo/dsh-client-ui-settings",
        "@neo/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@neo/dsh-api-remotes": "workspace:^",
    "@neo/dsh-client-locale": "workspace:^",
    "@neo/dsh-client-runtime": "workspace:^",
    "@neo/dsh-client-ui-settings": "workspace:^",
    "@neo/dsh-client-ui-slots": "workspace:^",
    "@neo/dsh-invariants": "workspace:^",
    "@neo/dsh-usage-stats": "workspace:^",
    "@neo/cordis": "workspace:^",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@neo/dsh-api-remotes": "workspace:^",
    "@neo/dsh-client-locale": "workspace:^",
    "@neo/dsh-client-runtime": "workspace:^",
    "@neo/dsh-client-test-runtime": "workspace:^",
    "@neo/dsh-client-ui-settings": "workspace:^",
    "@neo/dsh-client-ui-slots": "workspace:^",
    "@neo/dsh-invariants": "workspace:^",
    "@neo/dsh-usage-stats": "workspace:^",
    "@types/react": "~18.3.1",
    "@neo/cordis": "workspace:^",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
