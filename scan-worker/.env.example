# NEO free-scan worker — configuración (kryon)

# Base pública de la app en Vercel.
SCAN_API_BASE="https://www.skyvanguard.com.py"

# Token compartido (Bearer). El MISMO valor cargado en Vercel como
# SCAN_WORKER_TOKEN. Generar con: openssl rand -base64 48
SCAN_WORKER_TOKEN="pega-aqui-el-mismo-token-de-vercel"

# Identificador de este worker (aparece en logs y en worker_id del job).
SCAN_WORKER_ID="neo-kryon-1"

# Cómo invocar el CLI de NEO en kryon. Se parte por espacios. Ejemplos:
#   "dsh"                                  (binario instalado)
#   "pnpm dsh"                             (desde el repo, tras pnpm run build)
#   "node --import tsx/esm apps/cli/src/bin.ts"
DSH_CMD="pnpm dsh"

# Overlay de persona free-scan. Por defecto, el que está junto al worker.
# FREE_SCAN_PATCH="/ruta/al/free-scan.headless.patch.yml"

# Workspace del agente (directorio de trabajo del scan). Idealmente un dir
# aislado/efímero por seguridad, NO el checkout de NEO.
SCAN_WORKSPACE="/tmp/neo-scans"

# Cada cuánto consultar la cola cuando está vacía (ms).
SCAN_POLL_INTERVAL_MS="15000"

# Tope de tiempo por análisis antes de matar el proceso (ms). Default 75 min.
SCAN_TIMEOUT_MS="4500000"
